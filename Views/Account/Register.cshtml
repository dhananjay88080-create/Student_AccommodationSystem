@model StudentAccommodationSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}
<div class="row justify-content-center"><div class="col-md-7 col-lg-5"><div class="card"><div class="card-body p-4"><h2>Create account</h2><form method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control mb-3"/><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3"/><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3"/><label asp-for="Role" class="form-label">Account type</label><select asp-for="Role" class="form-select mb-3"><option>Student</option><option>Owner</option></select><button class="btn btn-primary">Register</button></form></div></div></div></div>
