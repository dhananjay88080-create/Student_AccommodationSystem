@model StudentAccommodationSystem.Models.Property
@{ ViewData["Title"] = Model.Name; var images=Model.Images.OrderByDescending(x=>x.IsPrimary).ToList(); var fallback="https://images.unsplash.com/photo-1560185008-b033106af5c3?auto=format&fit=crop&w=1600&q=85"; }
<div class="property-detail-hero mb-4"><div class="row g-0"><div class="col-lg-8"><div id="propertyGallery" class="carousel slide h-100" data-bs-ride="carousel"><div class="carousel-inner rounded-start-4 overflow-hidden">@if(images.Any()){for(var i=0;i<images.Count;i++){<div class="carousel-item @(i==0?"active":"")"><img src="@images[i].ImageUrl" class="detail-gallery-img" alt="@Model.Name photo @(i+1)" onerror="this.onerror=null;this.src='/images/dashboard-fallback.svg';"/></div>}}else{<div class="carousel-item active"><img src="@fallback" class="detail-gallery-img" alt="@Model.Name" onerror="this.onerror=null;this.src='/images/dashboard-fallback.svg';"/></div>}</div>@if(images.Count>1){<button class="carousel-control-prev" type="button" data-bs-target="#propertyGallery" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button><button class="carousel-control-next" type="button" data-bs-target="#propertyGallery" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>}</div></div><div class="col-lg-4 detail-summary"><span class="badge rounded-pill bg-success-subtle text-success-emphasis mb-3">@Model.Status</span><span class="eyebrow text-primary">@Model.PropertyType</span><h1>@Model.Name</h1><p class="text-muted">@Model.Address, @Model.City, @Model.State @Model.PostalCode</p><p>@Model.Description</p><div class="detail-meta"><span>📷 @images.Count photos</span><span>🛏 @Model.Rooms.Count rooms</span></div></div></div></div>
@if(User.IsInRole("Owner") || User.IsInRole("Administrator")){<div class="card border-0 shadow-sm rounded-4 p-4 mb-4"><div class="d-flex justify-content-between align-items-center"><div><h5 class="mb-1">Property photos</h5><p class="text-muted mb-0">Upload multiple images and choose a primary cover photo.</p></div><form asp-action="UploadImages" method="post" enctype="multipart/form-data" class="d-flex gap-2"><input type="hidden" name="propertyId" value="@Model.Id"/><input type="file" name="images" class="form-control" accept="image/jpeg,image/png,image/webp" multiple/><button class="btn btn-primary">Upload</button></form></div></div>}
<div class="d-flex justify-content-between align-items-center mb-3"><div><span class="eyebrow text-primary">AVAILABLE ROOMS</span><h3 class="mb-0">Choose your room</h3></div></div><div class="table-responsive premium-table"><table class="table align-middle"><thead><tr><th>Room</th><th>Type</th><th>Capacity</th><th>Rent</th><th>Furnished</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var r in Model.Rooms){<tr><td class="fw-semibold">@r.RoomNumber</td><td>@r.RoomType</td><td>@r.Capacity</td><td>₹@r.MonthlyRent.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td><td>@(r.IsFurnished?"Yes":"No")</td><td><span class="badge rounded-pill @(r.Status==StudentAccommodationSystem.Models.RoomStatus.Available?"bg-success-subtle text-success-emphasis":"bg-secondary-subtle text-secondary-emphasis")">@r.Status</span></td><td>@if(r.Status==StudentAccommodationSystem.Models.RoomStatus.Available && User.IsInRole("Student")){<a class="btn btn-sm btn-dark" asp-controller="Booking" asp-action="Create" asp-route-roomId="@r.Id">Request room</a>}</td></tr>}</tbody></table></div>