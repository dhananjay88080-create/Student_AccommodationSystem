@model StudentAccommodationSystem.Models.Property

@{
    ViewData["Title"] = "Add Property";
}
<h1>Add property</h1><form method="post" enctype="multipart/form-data" class="row g-3"><div asp-validation-summary="All" class="text-danger"></div><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/></div><div class="col-md-6"><label asp-for="PropertyType" class="form-label"></label><input asp-for="PropertyType" class="form-control"/></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control"/></div><div class="col-md-2"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control"/></div><div class="col-md-2"><label asp-for="State" class="form-label"></label><input asp-for="State" class="form-control"/></div><div class="col-md-2"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control"/></div><div class="col-md-4"><label asp-for="ContactPhone" class="form-label"></label><input asp-for="ContactPhone" class="form-control"/></div><div class="col-md-4"><label asp-for="SecurityDeposit" class="form-label"></label><input asp-for="SecurityDeposit" class="form-control"/></div><div class="col-12"><label class="form-label">Property photos</label><input type="file" name="images" class="form-control" accept="image/jpeg,image/png,image/webp" multiple/><div class="form-text">Upload up to 12 JPG, PNG or WebP images. The first image becomes the cover.</div></div><div class="col-12"><label asp-for="Rules" class="form-label"></label><textarea asp-for="Rules" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary">Submit property</button></div></form>
