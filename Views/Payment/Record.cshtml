@model StudentAccommodationSystem.ViewModels.PaymentVm

@{
    ViewData["Title"] = "Record Payment";
}
<h1>Record demo payment</h1><p class="text-muted">This project intentionally records/mock-processes payments and does not store card information.</p><form method="post" class="col-lg-6"><input type="hidden" asp-for="AgreementId"/><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select mb-3"><option value="Rent">Rent</option><option value="SecurityDeposit">Security deposit</option></select><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control mb-3"/><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control mb-3"/><label asp-for="Method" class="form-label"></label><input asp-for="Method" class="form-control mb-3"/><button class="btn btn-primary">Record paid</button></form>
