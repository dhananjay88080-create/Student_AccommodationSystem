@using Microsoft.AspNetCore.Identity
@using StudentAccommodationSystem.Models
@inject UserManager<ApplicationUser> UserManager
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] - StayNest</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body>
<nav class="market-nav"><div class="container nav-inner"><a class="brand-mark" asp-controller="Home" asp-action="Index"><span class="brand-dot">S</span><span>Stay<span>Nest</span></span></a><div class="nav-links"><a asp-controller="Property" asp-action="Index">Find a PG</a><a asp-controller="Info" asp-action="Support">Support</a><a asp-controller="Info" asp-action="Privacy">Privacy</a>@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Notification" asp-action="Index">Notifications</a>}</div><div class="nav-actions">@if(User.Identity?.IsAuthenticated==true){@if(User.IsInRole("Owner")){<a class="nav-list-btn" asp-controller="Property" asp-action="Create">List Property</a>}@if(User.IsInRole("Administrator")){<a class="nav-login" asp-controller="Admin" asp-action="Index">Dashboard</a><a class="nav-login" asp-controller="Admin" asp-action="Students">Students</a><a class="nav-login" asp-controller="Admin" asp-action="Owners">Owners</a><a class="nav-login" asp-controller="Admin" asp-action="Rooms">Rooms</a>}else if(User.IsInRole("Owner")){<a class="nav-login" asp-controller="Owner" asp-action="Index">Dashboard</a><a class="nav-login" asp-controller="Owner" asp-action="Rooms">My rooms</a><a class="nav-login" asp-controller="Owner" asp-action="Students">My students</a>}else if(User.IsInRole("Student")){<a class="nav-login" asp-controller="Student" asp-action="Index">Dashboard</a>}<form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-logout">Logout</button></form>}else{<a class="nav-login" asp-controller="Account" asp-action="Login">Sign in</a><a class="nav-list-btn" asp-controller="Account" asp-action="Register">Get started</a>}</div><button class="mobile-menu" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav">☰</button></div><div class="collapse" id="mobileNav"><div class="container mobile-links"><a asp-controller="Property" asp-action="Index">Find a PG</a><a asp-controller="Info" asp-action="Support">Customer support</a><a asp-controller="Info" asp-action="Faq">FAQs</a><a asp-controller="Info" asp-action="Privacy">Privacy policy</a><a asp-controller="Info" asp-action="Terms">Terms of use</a>@if(User.Identity?.IsAuthenticated==true){@if(User.IsInRole("Administrator")){<a asp-controller="Admin" asp-action="Index">Dashboard</a>}else if(User.IsInRole("Owner")){<a asp-controller="Owner" asp-action="Index">Dashboard</a>}else if(User.IsInRole("Student")){<a asp-controller="Student" asp-action="Index">Dashboard</a>}}</div></div></nav>
<main>@if(TempData["Success"]!=null){<div class="container pt-3"><div class="alert alert-success">@TempData["Success"]</div></div>}@if(TempData["Error"]!=null){<div class="container pt-3"><div class="alert alert-danger">@TempData["Error"]</div></div>}@RenderBody()</main><footer class="market-footer"><div class="container"><div><a class="brand-mark footer-brand" asp-controller="Home" asp-action="Index"><span class="brand-dot">S</span><span>Stay<span>Nest</span></span></a><p>Student accommodation and rental management, made simple.</p></div><div class="footer-links"><a asp-controller="Property" asp-action="Index">Find accommodation</a><a asp-controller="Home" asp-action="Index">About StayNest</a><a asp-controller="Info" asp-action="Support">Customer support</a><a asp-controller="Info" asp-action="Faq">FAQs</a><a asp-controller="Info" asp-action="Privacy">Privacy policy</a><a asp-controller="Info" asp-action="Terms">Terms of use</a></div></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
