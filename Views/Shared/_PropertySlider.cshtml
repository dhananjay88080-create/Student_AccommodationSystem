<section class="premium-slider-wrap mb-5">
  <div id="premiumPropertyCarousel" class="carousel slide premium-carousel" data-bs-ride="carousel" data-bs-interval="4500">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#premiumPropertyCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
      <button type="button" data-bs-target="#premiumPropertyCarousel" data-bs-slide-to="1"></button>
      <button type="button" data-bs-target="#premiumPropertyCarousel" data-bs-slide-to="2"></button>
    </div>
    <div class="carousel-inner rounded-4 overflow-hidden">
      <div class="carousel-item active">
        <img src="https://images.unsplash.com/photo-1560185893-a55cbc8c57e8?auto=format&fit=crop&w=1800&q=85" class="d-block w-100 premium-slide-img" onerror="this.onerror=null;this.src='/images/dashboard-fallback.svg';" alt="Modern student accommodation">
        <div class="carousel-caption premium-caption text-start"><span class="eyebrow">STAYNEST COLLECTION</span><h2>Find a place that feels like home.</h2><p>Premium student accommodation with comfortable rooms and connected living.</p><a class="btn btn-light px-4" asp-controller="Property" asp-action="Index">Explore stays</a></div>
      </div>
      <div class="carousel-item">
        <img src="https://images.unsplash.com/photo-1555854877-bab0e564b8d5?auto=format&fit=crop&w=1800&q=85" class="d-block w-100 premium-slide-img" onerror="this.onerror=null;this.src='/images/dashboard-fallback.svg';" alt="Student residence interior">
        <div class="carousel-caption premium-caption text-start"><span class="eyebrow">COMFORT FIRST</span><h2>Beautiful spaces for everyday living.</h2><p>Browse furnished rooms, shared spaces and amenities in one place.</p><a class="btn btn-light px-4" asp-controller="Property" asp-action="Index">View rooms</a></div>
      </div>
      <div class="carousel-item">
        <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1800&q=85" class="d-block w-100 premium-slide-img" onerror="this.onerror=null;this.src='/images/dashboard-fallback.svg';" alt="Premium apartment interior">
        <div class="carousel-caption premium-caption text-start"><span class="eyebrow">SMART RENTAL MANAGEMENT</span><h2>Search, book and manage your stay.</h2><p>Keep bookings, rent, maintenance and communication together.</p><a class="btn btn-light px-4" asp-controller="Property" asp-action="Index">Start exploring</a></div>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#premiumPropertyCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span><span class="visually-hidden">Previous</span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#premiumPropertyCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span><span class="visually-hidden">Next</span></button>
  </div>
</section>