@model IList<StudentAccommodationSystem.Models.Room>
@using StudentAccommodationSystem.Models
@{ ViewData["Title"] = "Manage My Rooms"; }
<div class="room-management-page">
    @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-warning alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    <div class="room-management-heading">
        <div><span class="eyebrow text-primary">OWNER WORKSPACE</span><h1>Manage my rooms</h1><p class="text-muted mb-0">Manage rooms linked to your properties, set rent separately for each room, and update availability.</p></div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to dashboard</a>
    </div>
    @if (((IList<StudentAccommodationSystem.Models.Property>)ViewBag.Properties).Count > 0)
    {
        <section class="room-management-panel">
            <h2 class="h5 mb-3">Add a room to your property</h2>
            <form asp-controller="Room" asp-action="Create" method="post">
                <div class="room-form-grid">
                    <div class="room-form-field"><label for="PropertyId">Property</label><select class="form-select" id="PropertyId" name="PropertyId" required>@foreach (var property in (IList<StudentAccommodationSystem.Models.Property>)ViewBag.Properties) { <option value="@property.Id">@property.Name</option> }</select></div>
                    <div class="room-form-field"><label for="RoomNumber">Room number</label><input class="form-control" id="RoomNumber" name="RoomNumber" required maxlength="50" /></div>
                    <div class="room-form-field"><label for="RoomType">Room type</label><select class="form-select" id="RoomType" name="RoomType"><option>Single</option><option>Double</option><option>Shared</option><option>Studio</option></select></div>
                    <div class="room-form-field"><label for="Capacity">Capacity</label><input class="form-control" id="Capacity" type="number" name="Capacity" value="1" min="1" max="20" required /></div>
                    <div class="room-form-field"><label for="MonthlyRent">Room monthly rent (₹)</label><input class="form-control" id="MonthlyRent" type="number" name="MonthlyRent" min="0" step="0.01" required /></div>
                    <div class="room-form-field"><button class="btn btn-primary w-100" type="submit">Add room</button></div>
                </div>
            </form>
        </section>
    }
    <div class="room-table-wrap table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Room ID</th><th>Property</th><th>Room</th><th>Monthly rent</th><th>Status</th><th>Update status</th><th>Actions</th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-5">No rooms found yet. Add a room to one of your properties to get started.</td></tr> }
            @foreach (var room in Model) { <tr><td>@room.Id</td><td class="fw-semibold">@room.Property.Name</td><td>@room.RoomNumber <span class="text-muted">(@room.RoomType)</span></td><td><span class="room-rent">₹@room.MonthlyRent.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</span></td><td><span class="badge rounded-pill bg-light text-dark border">@room.Status</span></td><td><form asp-action="SetRoomStatus" method="post" class="room-status-form"><input type="hidden" name="id" value="@room.Id"/><select class="form-select form-select-sm" name="status" aria-label="Room status">@foreach (RoomStatus status in Enum.GetValues(typeof(RoomStatus))) { <option value="@status" selected="@(status == room.Status)">@status</option> }</select><button class="btn btn-sm btn-primary" type="submit">Save</button></form></td><td><form asp-action="DeleteRoom" method="post" onsubmit="return confirm('Delete this room? Rooms with booking, rental-agreement, or maintenance history cannot be deleted.');"><input type="hidden" name="id" value="@room.Id"/><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr> }
            </tbody>
        </table>
    </div>
</div>
