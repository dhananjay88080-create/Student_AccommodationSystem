@{
    ViewData["Title"] = "Customer Support";
}
<section class="info-hero">
    <div class="container py-5">
        <span class="info-eyebrow">WE'RE HERE TO HELP</span>
        <h1>Customer support</h1>
        <p>Need help with your account, a booking, a room listing, or a payment? Contact the StayNest support team.</p>
    </div>
</section>
<section class="container info-content py-5">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="info-card h-100">
                <div class="info-icon">✉</div>
                <h2>Contact StayNest</h2>
                <p>Send us a message with a short description of the issue. If it's about a booking, include your booking reference, but never send your password or payment card details.</p>
                <a class="info-email" href="mailto:Admin@StayNest.com">Admin@StayNest.com</a>
                <div class="mt-4"><a class="btn btn-primary" href="mailto:Admin@StayNest.com?subject=StayNest%20Support%20Request">Email customer support</a></div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="info-card h-100">
                <h2>How we can help</h2>
                <ul class="info-list">
                    <li>Login and account access</li>
                    <li>Booking requests and cancellations</li>
                    <li>Room listings and availability</li>
                    <li>Payment or rental agreement questions</li>
                    <li>Report a safety or listing concern</li>
                </ul>
                <a asp-controller="Info" asp-action="Faq" class="info-text-link">Browse frequently asked questions →</a>
            </div>
        </div>
    </div>
</section>
