@{
    ViewData["Title"] = "Frequently Asked Questions";
}
<section class="info-hero"><div class="container py-5"><span class="info-eyebrow">QUICK ANSWERS</span><h1>Frequently asked questions</h1><p>Helpful basics for finding accommodation and managing your StayNest account.</p></div></section>
<section class="container info-content py-5"><div class="info-card">
    <div class="faq-item"><h2>How do I find a PG or room?</h2><p>Open <a asp-controller="Property" asp-action="Index">Find a PG</a> to browse available accommodation and review listing details.</p></div>
    <div class="faq-item"><h2>Is a booking request automatically approved?</h2><p>No. A request may need to be reviewed by the owner. Check the status shown in My Bookings.</p></div>
    <div class="faq-item"><h2>How can I manage a room listing?</h2><p>Owners can use their dashboard to manage their properties and rooms. Administrators can manage rooms across the platform.</p></div>
    <div class="faq-item"><h2>How do I get help with my account?</h2><p>Email <a href="mailto:Admin@StayNest.com">Admin@StayNest.com</a> and describe the issue. Never include your password or one-time codes.</p></div>
    <div class="faq-item"><h2>Where can I read the site policies?</h2><p>See our <a asp-controller="Info" asp-action="Privacy">Privacy Policy</a> and <a asp-controller="Info" asp-action="Terms">Terms of Use</a>.</p></div>
</div></section>
