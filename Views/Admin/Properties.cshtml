@model IEnumerable<StudentAccommodationSystem.Models.Property>

@{
    ViewData["Title"] = "Property Approvals";
}
<h1>Property approvals</h1><table class="table"><thead><tr><th>Property</th><th>Owner</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name</td><td>@p.Owner.User.FullName</td><td>@p.Status</td><td>@if(p.Status=="Pending"){<form asp-action="ApproveProperty" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-success">Approve</button></form>}</td></tr>}</tbody></table>
